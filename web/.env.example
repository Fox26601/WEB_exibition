# Auth.js / NextAuth (Google OAuth only)
AUTH_SECRET=generate-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Preferred (overrides AUTH_GOOGLE_* when set)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated allowlist (case-insensitive)
ADMIN_EMAILS=you@gmail.com

# Optional absolute URL in production
# AUTH_URL=https://webgalerey.app

# Exhibition 3D: three (default in app) or unity (legacy WebGL visitor path)
# Production: NEXT_PUBLIC_GALLERY_RENDERER=three
# NEXT_PUBLIC_GALLERY_RENDERER=three

# Vercel Blob — omit for local file fallback under web/.data/
BLOB_READ_WRITE_TOKEN=

# Draft catalog preview JWT signing (falls back to AUTH_SECRET)
CATALOG_SIGNING_SECRET=
