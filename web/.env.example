# Auth.js / NextAuth (Google OAuth only)
AUTH_SECRET=generate-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowlist (case-insensitive)
ADMIN_EMAILS=you@gmail.com

# Optional absolute URL in production
# AUTH_URL=https://your-domain.vercel.app

# Vercel Blob — omit for local file fallback under web/.data/
BLOB_READ_WRITE_TOKEN=

# Draft catalog preview JWT signing (falls back to AUTH_SECRET)
CATALOG_SIGNING_SECRET=
