{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/unity/Build/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "/unity/Build/(.*)\\.framework\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "/unity/Build/(.*)\\.loader\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    },
    {
      "source": "/unity/Build/(.*)\\.(data|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable, no-transform"
        }
      ]
    }
  ]
}